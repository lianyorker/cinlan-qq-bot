# Primary runtime. native loads Cinlan code into the official QQNT process.
QQ_PLATFORM=native
QQNT_PATH=
QQNT_AUTO_LAUNCH=true
QQNT_ALLOW_RUNNING=false
QQNT_LOADER_PATH=bin/cinlan-qq-loader.exe
QQNT_HOOK_PATH=bin/cinlan-qq-hook.dll
QQNT_LOAD_PATH=runtime/qqnt/load-cinlan.cjs
QQNT_RUNTIME_PATH=runtime/qqnt/runtime.cjs
QQNT_PATCH_PACKAGE_PATH=data/runtime/qqnt-package.json
QQNT_IPC_LISTEN_ADDR=127.0.0.1:18081
QQNT_IPC_TOKEN=
QQNT_ACTION_TIMEOUT=10s
QQNT_HANDSHAKE_TIMEOUT=10s
QQNT_MAX_FRAME_BYTES=1048576

# Explicit comma-separated group IDs. Use * only when every joined group is intended.
QQ_GROUP_ALLOWLIST=123456789
# Empty disables private chat. Use explicit QQ IDs, or * only when every private chat is intended.
QQ_PRIVATE_ALLOWLIST=
QQ_REQUIRE_MENTION=true
QQ_QUOTE_REPLY=true
QQ_GROUP_AT_SENDER=true
QQ_MAX_REPLY_RUNES=1500
QQ_MAX_REPLY_CHUNKS=4

# custom: use the contract in docs/custom-agent-api.md.
# openai: call an OpenAI-compatible /chat/completions endpoint.
AGENT_API_MODE=custom
AGENT_API_URL=http://127.0.0.1:9000/v1/qq/reply
AGENT_API_KEY=
AGENT_MODEL=
AGENT_AUTH_HEADER=Authorization
AGENT_AUTH_SCHEME=Bearer
AGENT_TIMEOUT=30s
AGENT_MAX_RETRIES=3
AGENT_MAX_TOOL_ROUNDS=4
AGENT_RETRY_BASE=500ms
AGENT_RETRY_MAX=5s

# Leave commented to use the built-in Chinese customer-service prompt.
# AGENT_SYSTEM_PROMPT=You are the Cinlan group customer-service assistant.

SESSION_MAX_HISTORY=20
SESSION_TTL=24h
SESSION_STORE_PATH=data/sessions.json
CRON_STORE_PATH=data/cron.json
KNOWLEDGE_DIR=
KNOWLEDGE_TOP_K=3
MCP_SERVERS_FILE=
SKILLS_DIR=
SUBAGENTS_FILE=
PLUGINS_FILE=
PROVIDERS_FILE=
FILE_CATALOG_PATH=
FILE_DELIVERY_MAX_BYTES=104857600
FILE_DELIVERY_TIMEOUT=30s
BOT_MAX_CONCURRENCY=8
BOT_USER_COOLDOWN=1s
BOT_MESSAGE_DEDUPE_TTL=10m

HTTP_LISTEN_ADDR=127.0.0.1:18080
ADMIN_API_TOKEN=replace-with-a-strong-admin-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
LOG_LEVEL=info

# Optional OneBot 11 compatibility mode. Set QQ_PLATFORM=onebot to use it.
ONEBOT_TRANSPORT=forward_ws
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_HTTP_URL=http://127.0.0.1:3000
ONEBOT_REVERSE_LISTEN_ADDR=127.0.0.1:3002
ONEBOT_REVERSE_PATH=/onebot/v11/ws
ONEBOT_ACCOUNTS_FILE=
ONEBOT_ACCESS_TOKEN=
ONEBOT_ACTION_TIMEOUT=10s

# Docker-only compatibility values used by compose.yaml.
NAPCAT_WEBUI_TOKEN=replace-with-a-strong-webui-token
NAPCAT_UID=1000
NAPCAT_GID=1000
BOT_UID=1000
BOT_GID=1000
NAPCAT_WEBUI_PORT=6099
BOT_STATUS_PORT=18080
