# Primary runtime. native is supported only on Windows x64 and injects into QQNT.
# Linux/macOS release packages and containers must use onebot with an external
# OneBot 11 service. The Docker image defaults QQ_PLATFORM to onebot.
QQ_PLATFORM=native
QQNT_PATH=
QQNT_AUTO_LAUNCH=true
QQNT_ALLOW_RUNNING=false
QQNT_AUTO_ACCEPT_FRIEND=false
QQNT_HEADLESS=false
QQNT_LOGIN_UIN=
QQNT_LOADER_PATH=bin/cinlan-qq-loader.exe
QQNT_HOOK_PATH=bin/cinlan-qq-hook.dll
QQNT_LOAD_PATH=runtime/qqnt/load-cinlan.cjs
QQNT_RUNTIME_PATH=runtime/qqnt/runtime.cjs
QQNT_PATCH_PACKAGE_PATH=data/runtime/qqnt-package.json
QQNT_IPC_LISTEN_ADDR=127.0.0.1:18081
QQNT_IPC_TOKEN=
QQNT_ACTION_TIMEOUT=10s
QQNT_HANDSHAKE_TIMEOUT=10s
QQNT_MAX_FRAME_BYTES=1048576
# Optional semicolon-separated absolute QQ image cache roots. By default the
# current QQNT_LOGIN_UIN Pic directory under %USERPROFILE% is used.
# QQNT_IMAGE_ALLOWED_ROOTS=C:\Users\Example\Documents\Tencent Files\123456789\nt_qq\nt_data\Pic
QQNT_IMAGE_MAX_BYTES=20971520

# Explicit comma-separated group IDs. Use * only when every joined group is intended.
QQ_GROUP_ALLOWLIST=123456789
# Empty disables private chat. Use explicit QQ IDs, or * only when every private chat is intended.
QQ_PRIVATE_ALLOWLIST=
QQ_REQUIRE_MENTION=true
QQ_QUOTE_REPLY=true
QQ_GROUP_AT_SENDER=true
QQ_MAX_REPLY_RUNES=1500
QQ_MAX_REPLY_CHUNKS=4
QQ_GROUP_BATCH_WINDOW=900ms
QQ_REPLY_PART_DELAY=350ms

# custom: use the contract in docs/custom-agent-api.md.
# openai: call an OpenAI-compatible /chat/completions endpoint.
AGENT_API_MODE=custom
AGENT_API_URL=http://127.0.0.1:9000/v1/qq/reply
AGENT_API_KEY=
AGENT_MODEL=
AGENT_AUTH_HEADER=Authorization
AGENT_AUTH_SCHEME=Bearer
AGENT_TIMEOUT=30s
AGENT_MAX_RETRIES=3
AGENT_MAX_TOOL_ROUNDS=4
AGENT_RETRY_BASE=500ms
AGENT_RETRY_MAX=5s

# Optional image generation Tool. Leave IMAGE_API_MODE empty to disable it.
# openai uses a compatible /images/generations endpoint. pollinations uses
# the configured public image endpoint and does not require an API key.
IMAGE_API_MODE=
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_OUTPUT_DIR=data/generated-images
IMAGE_MAX_BYTES=20971520
IMAGE_TIMEOUT=120s
IMAGE_RETENTION=24h
IMAGE_ENHANCE_PROMPT=true

# Optional real webpage screenshot Tool. Only exact HTTPS hosts listed here
# are accepted; browser traffic is restricted to public network addresses.
WEB_SCREENSHOT_ENABLED=false
WEB_SCREENSHOT_BROWSER_PATH=
WEB_SCREENSHOT_ALLOWED_HOSTS=example.com,github.com,gitee.com
WEB_SCREENSHOT_OUTPUT_DIR=data/generated-images
WEB_SCREENSHOT_TIMEOUT=45s
WEB_SCREENSHOT_RETENTION=24h
WEB_SCREENSHOT_MAX_BYTES=20971520
WEB_SCREENSHOT_WIDTH=1365
WEB_SCREENSHOT_HEIGHT=768
WEB_SCREENSHOT_WAIT=3s

# Leave commented to use the built-in Chinese customer-service prompt.
# AGENT_SYSTEM_PROMPT=You are the Cinlan group customer-service assistant.

SESSION_MAX_HISTORY=20
SESSION_TTL=24h
SESSION_STORE_PATH=data/sessions.db
SESSION_LEGACY_STORE_PATH=data/sessions.json
# Required when SESSION_STORE_PATH is set. Generate a random 32-byte base64 key
# and store it in the process/user environment, not in this file.
# SESSION_ENCRYPTION_KEY=
SESSION_COMPRESSION_THRESHOLD=16
SESSION_COMPRESSION_RETAIN=6
SESSION_LEARNING_ENABLED=true
CRON_STORE_PATH=data/cron.json
KNOWLEDGE_DIR=
KNOWLEDGE_TOP_K=3
MCP_SERVERS_FILE=
SKILLS_DIR=
SUBAGENTS_FILE=
PLUGINS_FILE=
PROVIDERS_FILE=
FILE_CATALOG_PATH=
FILE_DELIVERY_MAX_BYTES=104857600
FILE_DELIVERY_TIMEOUT=30s
# All model-triggered local paths must remain under this directory.
BOT_ALLOWED_ROOT=.
SECURITY_INCIDENT_STORE_PATH=data/security-incidents.json
BOT_MAX_CONCURRENCY=8
BOT_USER_COOLDOWN=3s
BOT_USER_RATE_LIMIT=10
BOT_USER_RATE_WINDOW=1m
# Separate budget for AI reply decisions; applies before the normal answer call.
BOT_ATTENTION_TIMEOUT=5s
BOT_ATTENTION_RATE_LIMIT=20
BOT_ATTENTION_RATE_WINDOW=1m
MEDIA_TOOL_USER_COOLDOWN=30s
MEDIA_TOOL_USER_LIMIT=10
MEDIA_TOOL_WINDOW=1h
MEDIA_TOOL_MAX_CONCURRENCY=2
BOT_MESSAGE_DEDUPE_TTL=10m

HTTP_LISTEN_ADDR=127.0.0.1:18080
ADMIN_API_TOKEN=replace-with-a-strong-admin-token
LOG_LEVEL=info

# Optional OneBot 11 compatibility mode. Set QQ_PLATFORM=onebot to use it.
ONEBOT_TRANSPORT=forward_ws
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_HTTP_URL=http://127.0.0.1:3000
ONEBOT_REVERSE_LISTEN_ADDR=127.0.0.1:3002
ONEBOT_REVERSE_PATH=/onebot/v11/ws
ONEBOT_ACCOUNTS_FILE=
ONEBOT_ACCESS_TOKEN=
# Auto-approve incoming friend requests (OneBot mode only). Useful when the
# customer-service flow asks users to add the bot before private file delivery.
ONEBOT_AUTO_ACCEPT_FRIEND=false
ONEBOT_ACTION_TIMEOUT=10s

# Docker-only compatibility values used by compose.yaml.
NAPCAT_WEBUI_TOKEN=replace-with-a-strong-webui-token
NAPCAT_UID=1000
NAPCAT_GID=1000
BOT_UID=1000
BOT_GID=1000
NAPCAT_WEBUI_PORT=6099
BOT_STATUS_PORT=18080
